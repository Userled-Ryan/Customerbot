# =============================================================================
# Slack app credentials (from api.slack.com/apps)
# =============================================================================
CUSTOMERBOT_SLACK__BOT_TOKEN=xoxb-...
CUSTOMERBOT_SLACK__SIGNING_SECRET=...

# Your Slack workspace URL (e.g. https://yourcompany.slack.com)
CUSTOMERBOT_SLACK__WORKSPACE_URL=https://yourcompany.slack.com

# =============================================================================
# SE / CTO identity
# =============================================================================
# Solutions Engineer Slack user ID (the "owner" of the v1 ticketing flow).
# Find it in Slack: click your profile → "Copy member ID".
# `CUSTOMERBOT_SE_USER_ID` is the canonical key; the legacy
# `CUSTOMERBOT_RYAN_USER_ID` is still accepted for backwards compatibility.
CUSTOMERBOT_SE_USER_ID=U0123456789

# CTO Slack user ID. Used for P0 candidate flagging and SE-OOO fallback
# (flow §13). Optional until those features land.
# CUSTOMERBOT_CTO_USER_ID=U0123456789

# =============================================================================
# Channels (Slack channel IDs, e.g. C0123ABCD)
# =============================================================================
# `#tech-assistance` — CSM intake channel + in-app-bug feed.
# CUSTOMERBOT_TECH_ASSISTANCE_CHANNEL_ID=C...

# `#product` — when set, `/log` invoked from this channel pre-selects the
# "#product" source. Purely a source-dropdown default; unset is a safe no-op.
# CUSTOMERBOT_PRODUCT_CHANNEL_ID=C...

# Internal channel where the bot posts the live ticket-card feed (the v1
# board replacement). Each ticket is one Slack message kept in sync via
# chat.update on every state change.
# CUSTOMERBOT_SE_TICKETS_CHANNEL_ID=C...

# Channel where the bot pings @support on SE → Dev Action handoff.
# CUSTOMERBOT_SUPPORT_PING_CHANNEL_ID=C...

# =============================================================================
# User groups / handles
# =============================================================================
# Slack user-group ID(s) for "internal members" (flow §3a). The bot only treats
# `log` / `check` messages from members of these groups as ticket-triggering.
# Accepts a single ID or a comma-separated list — the detector fires if the
# sender is in ANY listed group (e.g. CS + Sales + Devs = "anyone internal").
# Find IDs via the Slack API: usergroups.list — IDs start with `S`.
# CUSTOMERBOT_INTERNAL_USER_GROUP_ID=S...,S...,S...

# Slack user-group ID for the @support rotation (flow §7a/§7b).
# Bot pings via <!subteam^S...> on SE → Dev handoff. Slack handles rotation
# membership; the bot doesn't need to know who's currently on rotation.
# CUSTOMERBOT_SUPPORT_HANDLE=S...

# =============================================================================
# Feature configuration
# =============================================================================
# JSON list of feature names considered "critical-path" (flow §5c, P0
# candidate flagging). Example: '["publishing","scheduling","reporting"]'
# CUSTOMERBOT_CRITICAL_PATH_FEATURES=[]

# Path to the prio matrix YAML (decision #4). Example: config/prio_matrix.yaml
# CUSTOMERBOT_PRIO_MATRIX_PATH=config/prio_matrix.yaml

# SLA targets per priority tier. Defaults from flow §5d are used if unset.
# Override with a JSON dict if you've calibrated different targets.
# CUSTOMERBOT_SLA_TARGETS={"P0":{"first_response_minutes":30,...}}

# =============================================================================
# Webhooks
# =============================================================================
# HMAC-SHA256 shared secret for the in-app-bug webhook (flow §3d).
# Generate with: openssl rand -hex 32
# CUSTOMERBOT_INAPP_WEBHOOK_SECRET=

# Signing secret of the Linear webhook pointed at POST /webhooks/linear.
# Created when you add the webhook in Linear (Settings → API → Webhooks).
# Without it the inbound endpoint fails closed. Inbound is verified against
# the raw body via the Linear-Signature header.
# CUSTOMERBOT_LINEAR__WEBHOOK_SECRET=

# =============================================================================
# Linear mirror (v1.5)
# =============================================================================
# Every ticket is mirrored into a Linear issue: dev-action tickets live in the
# Product Responder project for engineers; SE-resolved tickets are created and
# silently closed for CTO reporting. Leave the whole block unset to disable
# Linear entirely (the app boots and runs Slack-only).
#
# Required:
# CUSTOMERBOT_LINEAR__API_TOKEN=lin_api_...   # Settings → API → Personal API keys
# CUSTOMERBOT_LINEAR__TEAM_ID=...             # the team owning the project (userledio: Product / PRO)
#
# Optional — auto-resolved from the API token at startup if omitted:
# CUSTOMERBOT_LINEAR__PROJECT_ID=...          # Product Responder project
# CUSTOMERBOT_LINEAR__ACTOR_ID=...            # our own Linear user (loop filter)
# Workflow-state ids. The Product team has no "Triage" state, so these are set
# explicitly (new tickets → Todo); see docs/integrations/linear.md for the ids.
# CUSTOMERBOT_LINEAR__WORKFLOW_STATES__TRIAGE=<stateId>          # Todo, for userledio/Product
# CUSTOMERBOT_LINEAR__WORKFLOW_STATES__IN_PROGRESS=<stateId>
# CUSTOMERBOT_LINEAR__WORKFLOW_STATES__AWAITING_CUSTOMER=<stateId>
# CUSTOMERBOT_LINEAR__WORKFLOW_STATES__DONE=<stateId>
# CUSTOMERBOT_LINEAR__WORKFLOW_STATES__CANCELED=<stateId>

# =============================================================================
# Feature flags
# =============================================================================
# Set to true to re-enable the legacy /csbot subcommands (`keyword`,
# `timezone`, `reminder`, `alerts`, `settings`, `summary`, `close`) and the
# `app_mention` auto-summary. None of these are part of the v1 ticketing flow;
# they're kept for transitional use only. Default: false.
CUSTOMERBOT_LEGACY_COMMANDS_ENABLED=false

# =============================================================================
# Infrastructure
# =============================================================================
# Where to store the SQLite database. Postgres-portable via SQLAlchemy when
# we outgrow SQLite.
CUSTOMERBOT_DATABASE_PATH=data/customerbot.db
